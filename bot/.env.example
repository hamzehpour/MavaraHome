# --- Secrets only. Never commit the real .env file. ---
BOT_TOKEN=your_bot_token_from_botfather
# Comma separated telegram numeric ids of the first (bootstrap) admins.
# After the bot is running, more admins can be added from inside the admin panel.
BOOTSTRAP_ADMIN_IDS=123456789

# --- Environment: production / test / development ---
# This is the ONLY thing that controls which database this process talks
# to. There is deliberately no "switch database" button inside the bot —
# switching environments means editing this file and restarting the bot,
# so it can never happen by an accidental tap. Each environment gets its
# own database file automatically: data/production.db, data/test.db,
# data/development.db.
ENV=production

# DEBUG=true only has any effect when ENV is NOT production (it's force-
# disabled in production regardless of this value). When on, the bot will
# refuse to start against an empty database without you first running
# `python seed_database.py` — see README for details.
DEBUG=false

# --- Advanced: only set this if you need a database file in a custom
# location. Leave commented out to use the automatic per-environment
# naming above (recommended). ---
# DB_PATH=data/mavara.db

LOG_FILE=logs/app.log

# --- Phase 1: Unified API (used by api/server.py, shared by the website
# and admin panel — the Telegram bot itself doesn't need any of these) ---

# DEPRECATED (Phase 2): the static X-Admin-Token header is no longer
# accepted by any admin endpoint — real per-admin JWT login replaced it
# (see JWT_SECRET below, and create_web_admin.py to create an account).
# Kept only so old .env files don't crash on a missing variable.
API_ADMIN_TOKEN=1234

# REQUIRED for admin login to work. A long, random, secret string used to
# sign admin JWTs — generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing this instantly invalidates every issued token (forces re-login
# for all admins) — useful if a token ever leaks.
JWT_SECRET=

# Port the unified API listens on. Nginx (see deploy/nginx.conf.example)
# reverse-proxies /api/v1/ and /media/ here.
API_PORT=8788

# Only set this for a quick single-process deployment where the API also
# serves the static website files directly (no Nginx needed) — point it
# at the folder containing the website's index.html. Leave unset for the
# recommended production setup (Nginx serves static files, proxies API
# calls to this process — see DEPLOYMENT.md).
# STATIC_ROOT=/opt/mavara-home-website

