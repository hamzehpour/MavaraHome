# Mavara Home — Nginx configuration
#
# Serves the static website directly (fast, no Python involved for HTML/
# CSS/JS/images) and reverse-proxies API calls + uploaded media to the
# unified Python API service (mavara-api.service, port 8788).
#
# This is the recommended production setup (vs. the API's own built-in
# STATIC_ROOT single-process mode, which exists for quick/local testing).
#
# Install:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/mavara-home
#   sudo ln -s /etc/nginx/sites-available/mavara-home /etc/nginx/sites-enabled/
#   sudo nano /etc/nginx/sites-available/mavara-home   # fill in your domain + paths
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then get a real TLS certificate (do not serve this over plain HTTP in
# production — OTP/receipt uploads/admin tokens must never be sent
# unencrypted):
#   sudo certbot --nginx -d mavara-home.example.com

server {
    listen 80;
    server_name mavara-home.example.com;  # <-- CHANGE THIS

    # Static website (index.html, pages/, assets/)
    root /opt/mavara-home-website;  # <-- path to the extracted website zip
    index index.html;

    # HTML/JS/CSS must always be revalidated with the server before a
    # cached copy is trusted. Without this, nginx sends no Cache-Control
    # header at all, so each browser applies its own heuristic caching —
    # and after a deploy that touches multiple files, one can end up
    # served fresh while another stays stale (e.g. new site.js loaded
    # against old styles.css), producing broken-looking behavior with no
    # error, until the visitor happens to hard-refresh. `no-cache` still
    # lets the browser keep a local copy; it just forces a conditional GET
    # first — cheap, since nginx already sends an ETag/Last-Modified and
    # answers with a 304 when the file hasn't actually changed.
    location ~* \.(?:html|js|css)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Unified API
    location /api/v1/ {
        proxy_pass http://127.0.0.1:8788;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 20M;  # receipts/posters are uploaded as base64 JSON, inflates ~33%
    }

    # Uploaded media (posters, gallery, videos, payment receipts)
    location /media/ {
        proxy_pass http://127.0.0.1:8788;
        proxy_set_header Host $host;
    }
}
