[Unit]
Description=Mavara Home Unified API (website + admin panel backend)
After=network.target

[Service]
Type=simple
User=mavara
WorkingDirectory=/opt/MavaraHome/bot
EnvironmentFile=/opt/MavaraHome/bot/.env
ExecStart=/opt/MavaraHome/bot/venv/bin/python -m api.server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
