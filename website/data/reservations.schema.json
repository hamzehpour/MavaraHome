{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maavara Reservation",
  "description": "Stable contract for a future backend or reservation bot adapter. The current static site stores these records in localStorage.",
  "type": "object",
  "required": ["eventId", "name", "contact", "quantity", "status", "createdAt"],
  "properties": {
    "id": { "type": "string" },
    "eventId": { "type": "string", "description": "ID from data/events.json" },
    "name": { "type": "string", "minLength": 1 },
    "contact": { "type": "string", "minLength": 1 },
    "quantity": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["pending", "confirmed", "cancelled", "completed"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "note": { "type": "string" }
  }
}
