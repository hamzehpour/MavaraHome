{
  "openapi": "3.0.3",
  "info": {
    "title": "Maavara Home API",
    "version": "1.0.0",
    "description": "Shared API contract for website, admin panel and future Telegram bot. The current static package ships a localStorage fallback, not a live server."
  },
  "servers": [
    {
      "url": "https://api.example.invalid/api/v1",
      "description": "Configure MAAVARA_API_BASE in a deployed backend; placeholder only."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/events": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Active events"
          }
        }
      },
      "post": {
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/events/{id}": {
      "get": {
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Event"
          }
        }
      },
      "patch": {
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "204": {
            "description": "Soft deleted"
          }
        }
      }
    },
    "/events/{id}/dates": {
      "get": {
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Jalali event dates"
          }
        }
      },
      "post": {
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "201": {
            "description": "Date created"
          }
        }
      }
    },
    "/sessions": {
      "get": {
        "security": [],
        "parameters": [
          {
            "name": "event_date_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sessions with server capacity and price"
          }
        }
      }
    },
    "/reservations": {
      "post": {
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reservation or waiting-list result"
          },
          "409": {
            "description": "Capacity handled server-side; waiting list offered"
          }
        }
      },
      "get": {
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ReservationStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Admin reservations"
          }
        }
      }
    },
    "/reservations/{id}": {
      "get": {
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Reservation"
          }
        }
      },
      "patch": {
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/ReservationStatus"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      }
    },
    "/payments": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "reservation_id",
                  "amount"
                ],
                "properties": {
                  "reservation_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "amount": {
                    "type": "number"
                  },
                  "receipt_image": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment submitted"
          }
        }
      }
    },
    "/users": {
      "get": {
        "parameters": [
          {
            "name": "phone",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Users"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "security": [],
        "responses": {
          "200": {
            "description": "Session token"
          }
        }
      }
    },
    "/audit-logs": {
      "get": {
        "responses": {
          "200": {
            "description": "Immutable admin audit entries"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "ReservationStatus": {
        "type": "string",
        "enum": [
          "pending_payment",
          "receipt_uploaded",
          "waiting_admin_confirmation",
          "approved",
          "rejected",
          "cancelled",
          "waiting"
        ]
      },
      "ReservationRequest": {
        "type": "object",
        "required": [
          "session_id",
          "ticket_count",
          "user"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "ticket_count": {
            "type": "integer",
            "minimum": 1
          },
          "user": {
            "type": "object",
            "required": [
              "first_name",
              "last_name",
              "phone"
            ],
            "properties": {
              "first_name": {
                "type": "string"
              },
              "last_name": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "telegram_id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}