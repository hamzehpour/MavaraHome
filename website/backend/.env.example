# Mavara Home Backend — environment sample
PORT=8787
# Shared secret between admin panel/backend and Telegram bot. NEVER put in frontend.
MAVARA_ADMIN_TOKEN=change-me-in-env
# JSON file store for dev/demo; production: Postgres (see database/migrations)
MAVARA_DB_FILE=./backend/src/data/db.json
# Telegram bot: same API base + token
MAVARA_TELEGRAM_BOT_TOKEN=
