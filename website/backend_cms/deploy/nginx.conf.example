# Mavara Home website — Nginx config for the real-VPS path (DEPLOYMENT_VPS.md)
#
# Serves the static site directly, serves uploaded media directly (never
# proxied through Python — see backend_cms's MEDIA_ROOT note), and
# reverse-proxies only /api/v1/ and /v1/ to the CMS backend
# (mavara-cms.service, gunicorn on 127.0.0.1:8790, localhost-only).
#
# Install:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/mavara-website
#   sudo ln -s /etc/nginx/sites-available/mavara-website /etc/nginx/sites-enabled/
#   sudo nano /etc/nginx/sites-available/mavara-website   # fill in your domain + paths
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then get a real TLS certificate (admin login must never go out over
# plain HTTP):
#   sudo certbot --nginx -d your-domain.example.com

server {
    listen 80;
    server_name your-domain.example.com;  # <-- CHANGE THIS

    # Static website (index.html, pages/, assets/)
    root /opt/mavara-website;  # <-- path to the website/ folder (this repo)
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Uploaded media — plain files on disk, served directly (no Python)
    location /media/ {
        alias /opt/mavara-website/media/;
    }

    # CMS API (content + admin) — both prefixes point at the same backend,
    # kept identical to the shared-hosting path so nothing else has to change
    # if you ever move hosts.
    location /api/v1/ {
        proxy_pass http://127.0.0.1:8790/api/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 15M;  # poster/gallery uploads are base64 JSON, inflates ~33%
    }

    location /v1/ {
        proxy_pass http://127.0.0.1:8790/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 15M;
    }
}
