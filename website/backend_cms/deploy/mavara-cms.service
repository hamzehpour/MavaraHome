[Unit]
Description=Mavara Home CMS backend (website/backend_cms — content + admin API only)
After=network.target

[Service]
Type=simple
User=mavara
WorkingDirectory=/opt/mavara-website/backend_cms
EnvironmentFile=/opt/mavara-website/backend_cms/.env
ExecStart=/opt/mavara-website/backend_cms/venv/bin/gunicorn -w 2 -b 127.0.0.1:8790 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
