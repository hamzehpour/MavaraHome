# Copy this to .env and fill in real values. Never commit the real .env.

# REQUIRED — a long, random, secret string used to sign admin JWTs.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing this instantly invalidates every issued token (forces
# re-login for all admins) — useful if a token ever leaks.
JWT_SECRET=

# Only needed for `flask run` local testing (see app.py's __main__
# block). Most cPanel/DirectAdmin Python App setups ignore this and
# pick their own port — set the "Application URL"/port from the panel
# instead.
PORT=8790

# Only set this if uploaded media should NOT go to the default sibling
# `media/` folder next to this app (i.e. website/media/). MUST be a
# path your webserver serves directly as static files — see
# DEPLOYMENT.md's "media/ must be web-accessible" note.
# MEDIA_ROOT=/home/youruser/public_html/media
